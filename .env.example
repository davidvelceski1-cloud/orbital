# Ask Orbital (AI guide) — Claude API key. Without it the guide answers from the
# built-in knowledge base only. Copy to .env.local and fill in.
ANTHROPIC_API_KEY=

# NASA Open APIs (Astronomy Picture of the Day on the dashboard). DEMO_KEY works
# but is heavily rate-limited; get a free key at https://api.nasa.gov
NASA_API_KEY=DEMO_KEY
